#include <windows.h>
#include "ui_ids.h"

#pragma code_page(65001)

#define TTK_STRINGIFY_VALUE(value) #value
#define TTK_STRINGIFY(value) TTK_STRINGIFY_VALUE(value)

1 RT_MANIFEST "app.manifest"

101 ICON "app.ico"
102 ICON "cat-welcome.ico"
103 ICON "cat-brand.ico"
104 RCDATA "../assets/ttk-rounded.ttf"

1 VERSIONINFO
 FILEVERSION TTK_VERSION_MAJOR,TTK_VERSION_MINOR,TTK_VERSION_PATCH,0
 PRODUCTVERSION TTK_VERSION_MAJOR,TTK_VERSION_MINOR,TTK_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "ttkConverter 格式转换器"
            VALUE "FileVersion", TTK_STRINGIFY(TTK_VERSION_TEXT)
            VALUE "InternalName", "ttkConverter"
            VALUE "OriginalFilename", "ttkConverter.exe"
            VALUE "ProductName", "ttkConverter"
            VALUE "ProductVersion", TTK_STRINGIFY(TTK_VERSION_TEXT)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

UI_ADVANCED_DIALOG DIALOGEX 0, 0, 282, 161
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "高级设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 1
BEGIN
    LTEXT "数值为 0 时使用自动设置。", UI_ADVANCED_HINT, 14, 12, 254, 19
    LTEXT "宽度（像素）", UI_ADVANCED_WIDTH_LABEL, 14, 38, 60, 11
    EDITTEXT UI_ADVANCED_WIDTH, 75, 35, 45, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "高度（像素）", UI_ADVANCED_HEIGHT_LABEL, 147, 38, 62, 11
    EDITTEXT UI_ADVANCED_HEIGHT, 213, 35, 55, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "视频 kb/s", UI_ADVANCED_VIDEO_RATE_LABEL, 14, 57, 60, 11
    EDITTEXT UI_ADVANCED_VIDEO_RATE, 75, 54, 45, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "音频 kb/s", UI_ADVANCED_AUDIO_RATE_LABEL, 147, 57, 62, 11
    EDITTEXT UI_ADVANCED_AUDIO_RATE, 213, 54, 55, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "音频声道", UI_ADVANCED_CHANNELS_LABEL, 14, 76, 60, 11
    EDITTEXT UI_ADVANCED_CHANNELS, 75, 73, 45, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "编码线程", UI_ADVANCED_THREADS_LABEL, 147, 76, 62, 11
    EDITTEXT UI_ADVANCED_THREADS, 213, 73, 55, 15, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "无损换封装", UI_ADVANCED_REMUX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 96, 110, 13
    CONTROL "尝试硬件编码", UI_ADVANCED_HARDWARE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 147, 96, 121, 13
    CONTROL "每页都运行 OCR（简体中文、英语）", UI_ADVANCED_OCR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 112, 254, 13
    DEFPUSHBUTTON "应用", IDOK, 151, 134, 55, 16
    PUSHBUTTON "取消", IDCANCEL, 213, 134, 55, 16
END
